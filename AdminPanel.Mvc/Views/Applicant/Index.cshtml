@model AdminPanel.Mvc.Models.Applicant.ApplicantViewModel

<div class="container mt-4">
    <h2>Список абитуриентов</h2>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }
    
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <div class="card">
        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h4 class="mb-0">Абитуриенты</h4>
                <span class="badge bg-light text-dark">Всего: @Model.Applicants.Count</span>
            </div>
        </div>
        <div class="card-body">
            @if (!Model.Applicants.Any())
            {
                <div class="alert alert-info">
                    Нет абитуриентов
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ФИО</th>
                                <th>Email</th>
                                <th>Телефон</th>
                                <th>Дата рождения</th>
                                <th>Пол</th>
                                <th>Гражданство</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var applicant in Model.Applicants)
                            {
                                <tr>
                                    <td>@applicant.FullName</td>
                                    <td>@applicant.Email</td>
                                    <td>@(applicant.PhoneNumber ?? "-")</td>
                                    <td>@applicant.BirthDay.ToString("dd.MM.yyyy")</td>
                                    <td>@applicant.Gender</td>
                                    <td>@(applicant.Citizenship ?? "-")</td>
                                    <td>
                                        <div class="btn-group">
                                            <a asp-action="Details" asp-route-applicantId="@applicant.Id"
                                               class="btn btn-info btn-sm" target="_blank">
                                                <i class="bi bi-eye"></i> Детали
                                            </a>
                                            @if (User.IsInRole("Administrator"))
                                            {
                                                <button type="button" class="btn btn-secondary btn-sm dropdown-toggle" 
                                                        data-bs-toggle="dropdown">
                                                    Изменить роль
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <li>
                                                        <form asp-controller="Applicant" asp-action="AssignRole" asp-route-userId="@applicant.Id" method="post">
                                                            <input type="hidden" name="role" value="Manager" />
                                                            <button type="submit" class="dropdown-item">Сделать менеджером</button>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <form asp-controller="Applicant" asp-action="AssignRole" asp-route-userId="@applicant.Id" method="post">
                                                            <input type="hidden" name="role" value="SeniorManager" />
                                                            <button type="submit" class="dropdown-item">Сделать главным менеджером</button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>